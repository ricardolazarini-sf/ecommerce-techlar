# ==========================================================================
# TechLar e-commerce — root env example (see server/.env.example for details)
# Copy to `.env` (never commit real secrets).
# ==========================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3001

# ---- Database (your OWN Postgres — NOT Salesforce) ----
# Local example: postgres://USER:PASSWORD@localhost:5432/techlar
DATABASE_URL=postgres://postgres:postgres@localhost:5432/techlar
# Set to true on Heroku Postgres (requires SSL).
PGSSL=false

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- Pricing ----
# Garantia estendida do PEDIDO: fração da base garantível (subtotal menos
# serviços e menos linhas em promoção).
WARRANTY_RATE=0.03

# ==========================================================================
# EVENT SINK (the pluggable Data 360 integration layer)
# EVENTS_SINK=console|file|datacloud   (default: console — nothing external)
# ==========================================================================
EVENTS_SINK=console
# Also mirror every emitted event into the local `events` table.
EVENTS_PERSIST_LOCAL=true
# Used only when EVENTS_SINK=file
EVENTS_FILE_PATH=./events.log

# ---- Data Cloud Ingestion API (used only when EVENTS_SINK=datacloud) ----
# This is a plain HTTP event sink. Nothing here authenticates a Salesforce org.
DATACLOUD_INGESTION_URL=
DATACLOUD_CONNECTOR=
DATACLOUD_TOKEN=
DATACLOUD_OBJECT=ecommerce_events
DATACLOUD_MAX_RETRIES=3
DATACLOUD_RETRY_BASE_MS=300
