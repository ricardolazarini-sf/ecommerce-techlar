# Client build-time configuration (Vite exposes VITE_* to the app).
# In dev the API is reached via the Vite proxy (see vite.config.js), so no base
# URL is needed. Override only if you serve the API from another origin.

# VITE_API_BASE=
VITE_WARRANTY_RATE=0.03

# Coletor de engajamento (events-server). Em dev vale o proxy /collect; em
# produção ele fica em outro domínio e o endereço entra aqui.
# VITE_COLLECT_BASE=https://eventos.techlar.example.com

# VITE_TRACK=0 desliga o rastreio de cliques — útil para rodar o site sem o
# coletor de pé, sem POST falhando no console.
