{
  "name": "techlar-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TechLar e-commerce REST API — layered, modular, with a pluggable Data 360 event sink.",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
