# ==========================================================================
# TechLar server configuration. Copy to `server/.env` for local development.
# NEVER commit real secrets — `.env` is gitignored.
# ==========================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3001
# In production, the API also serves the built SPA from ../client/dist.
# Optional: restrict CORS to a specific origin (defaults to permissive).
# CORS_ORIGIN=https://your-app.example.com
LOG_LEVEL=info

# ---- Database (this app's OWN Postgres — never a Salesforce org) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/techlar
# Heroku Postgres requires SSL — set to true there.
PGSSL=false

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- Pricing ----
WARRANTY_RATE=0.15

# ==========================================================================
# EVENT SINK — the pluggable Data 360 integration layer.
#   console  (default) : structured stdout, nothing leaves the process
#   file               : append JSON lines to EVENTS_FILE_PATH
#   datacloud          : POST to the Data Cloud Ingestion API (HTTP only)
# ==========================================================================
EVENTS_SINK=console
EVENTS_PERSIST_LOCAL=true
EVENTS_FILE_PATH=./events.log

# ---- Data Cloud Ingestion API (only used when EVENTS_SINK=datacloud) ----
DATACLOUD_INGESTION_URL=
DATACLOUD_CONNECTOR=
DATACLOUD_TOKEN=
DATACLOUD_OBJECT=ecommerce_events
DATACLOUD_MAX_RETRIES=3
DATACLOUD_RETRY_BASE_MS=300
