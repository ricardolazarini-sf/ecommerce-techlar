# ==========================================================================
# TechLar server configuration. Copy to `server/.env` for local development.
# NEVER commit real secrets — `.env` is gitignored.
# ==========================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3001
# In production, the API also serves the built SPA from ../client/dist.
# Optional: restrict CORS to a specific origin (defaults to permissive).
# CORS_ORIGIN=https://your-app.example.com
LOG_LEVEL=info

# ---- Database (this app's OWN Postgres — never a Salesforce org) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/techlar
# Heroku Postgres requires SSL — set to true there.
PGSSL=false

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- Admin (rotas /api/admin — operacional/demo) ----
# Token compartilhado exigido no header x-admin-token. VAZIO (default) = rotas
# admin respondem 404 (ficam desativadas). Usado para, p.ex., re-empurrar o
# status de um pedido ao CRM (dispara o e-mail proativo da US7.1).
ADMIN_TOKEN=

# ---- Pricing ----
# Garantia estendida do PEDIDO: fração da base garantível (subtotal menos
# serviços e menos linhas em promoção).
WARRANTY_RATE=0.03

# ==========================================================================
# ERP DE ESTOQUE (mock externo) — integração de consistência do checkout.
#   ERP_ENABLED=false (padrão): checkout NÃO fala com o ERP (comportamento atual).
#   ERP_ENABLED=true          : valida saldo antes de confirmar (bloqueia sem
#                               estoque) e dá baixa após o commit do pedido.
# ==========================================================================
ERP_ENABLED=false
# URL base do mock de ERP (ex.: http://localhost:3000 em dev, ou a URL do túnel).
ERP_BASE_URL=http://localhost:3000
# Timeout (ms) por chamada ao ERP.
ERP_TIMEOUT_MS=8000

# ==========================================================================
# ESPELHO DO PEDIDO NO CRM (Salesforce org) — base da US7.1 (e-mail proativo).
#   ORG_MIRROR_ENABLED=false (padrão): checkout NÃO fala com a org (atual).
#   ORG_MIRROR_ENABLED=true          : após o commit do pedido, espelha em
#                                      Person/Business Account + Order na org
#                                      (Apex REST /services/apexrest/web/order).
# Best-effort: falha aqui nunca derruba a compra. A auth reusa o JWT Bearer da
# seção "CLI de ingestão" abaixo (SF_LOGIN_URL / SF_CLIENT_ID / SF_USERNAME /
# SF_JWT_KEY_PATH) — o instanceUrl vem de getOrgAccessToken(), não há URL extra.
# ==========================================================================
ORG_MIRROR_ENABLED=false
# Timeout (ms) por chamada ao Apex REST da org.
ORG_MIRROR_TIMEOUT_MS=8000

# ==========================================================================
# EVENT SINK — the pluggable Data 360 integration layer.
#   console  (default) : structured stdout, nothing leaves the process
#   file               : append JSON lines to EVENTS_FILE_PATH
#   datacloud          : POST to the Data Cloud Ingestion API (HTTP only)
# ==========================================================================
EVENTS_SINK=console
EVENTS_PERSIST_LOCAL=true
EVENTS_FILE_PATH=./events.log

# ---- Data Cloud Ingestion API (only used when EVENTS_SINK=datacloud) ----
DATACLOUD_INGESTION_URL=
DATACLOUD_CONNECTOR=
DATACLOUD_TOKEN=
DATACLOUD_OBJECT=ecommerce_events
DATACLOUD_MAX_RETRIES=3
DATACLOUD_RETRY_BASE_MS=300

# ==========================================================================
# CLI de ingestão em lote — `npm run push:data360`
# (OAuth 2.0 JWT Bearer Flow; envia PF/PJ/pedidos do Postgres para a Data 360)
# Não precisa em runtime; só quando você roda o push manualmente.
# ==========================================================================
# My Domain da org (endpoint de login/token). Em sandbox pode ser test.salesforce.com.
SF_LOGIN_URL=https://SEU-DOMINIO.my.salesforce.com
# Opcional; padrão = SF_LOGIN_URL. Use se o `aud` do JWT precisar divergir.
# SF_AUDIENCE=https://login.salesforce.com
# Consumer Key da Connected App / External Client App (é o `iss` do JWT).
SF_CLIENT_ID=
# Usuário de integração (o `sub` do JWT) — precisa estar pré-autorizado no app.
SF_USERNAME=voce@empresa.com
# Chave privada RS256: aponte um arquivo .key OU cole o PEM inteiro (Render).
SF_JWT_KEY_PATH=./techlar_ingest.key
# SF_JWT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Lotes são por TAMANHO (teto oficial 200 KB/request); padrão 190000 bytes de margem.
# MAX_PAYLOAD_BYTES=190000
# DRY_RUN=true         # lê o banco e mostra amostras, sem autenticar/enviar
# VALIDATE_ONLY=true   # só valida no endpoint síncrono /actions/test, não ingere
