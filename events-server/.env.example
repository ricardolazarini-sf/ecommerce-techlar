# ==========================================================================
# Coletor de engajamento — copie para events-server/.env
#
# O que NÃO precisa estar aqui: JWT_SECRET e as chaves SF_* já vivem em
# server/.env e são lidas de lá (o arquivo local tem precedência se você quiser
# sobrescrever). Ver src/config/index.js.
# ==========================================================================

# ---- Runtime ----
NODE_ENV=development
EVENTS_PORT=3002
LOG_LEVEL=info

# Swagger em /docs (e a spec em /openapi.json). Ligado por padrão: é como se
# testa o /collect antes de apontar o site. Desligue (`false`) quando o coletor
# estiver recebendo tráfego real — a página manda POST de verdade, e evento de
# teste em produção suja o perfil na Data 360.
EVENTS_DOCS=true

# ---- Banco da fila (SEPARADO do banco do site) ----
# Em dev, outro database na mesma instância resolve:
#   createdb techlar_events
EVENTS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/techlar_events
EVENTS_PGSSL=false

# ---- CORS ----
# Em dev o navegador chega pelo proxy /collect do Vite (mesma origem) e nada
# disto importa. Em produção liste as origens do site, separadas por vírgula; o
# padrão do código já é a loja no Render (https://techlar-ecommerce.onrender.com).
# EVENTS_CORS_ORIGINS=https://techlar-ecommerce.onrender.com

# ---- Tetos do /collect ----
EVENTS_MAX_PER_REQUEST=50
EVENTS_MAX_BODY_BYTES=65536
EVENTS_RATE_WINDOW_MS=60000
EVENTS_RATE_MAX_REQUESTS=60
EVENTS_RATE_MAX_EVENTS=600

# ---- Flusher (fila -> Data Cloud) ----
EVENTS_FLUSH_ENABLED=true
EVENTS_FLUSH_INTERVAL_MS=5000
EVENTS_FLUSH_MAX_ROWS=500
# Teto oficial do request é 200 KB; 190000 deixa margem para headers.
EVENTS_MAX_PAYLOAD_BYTES=190000
EVENTS_MAX_ATTEMPTS=5
EVENTS_RETRY_BASE_MS=2000
# Enquanto o Data Stream de engajamento não existir na org, use um dos dois:
#   dry-run       = grava, loga a amostra e marca como enviado (não toca a org)
#   validate-only = valida no endpoint síncrono /actions/test, não ingere
EVENTS_DRY_RUN=true
EVENTS_VALIDATE_ONLY=false

# ---- Data Cloud (connector NOVO, dedicado a engajamento) ----
# O connector de PF/PJ/pedidos (TechLar_Ecom) não é usado aqui e continua
# intocado. Confira o nome antes de ligar a ingestão, sem gravar nada:
#   npm run probe -- TechLar_Engagement ecommerce_events
DATACLOUD_EVENTS_CONNECTOR=
DATACLOUD_EVENTS_OBJECT=ecommerce_events

# ---- Frontend ----
# O navegador não usa nada daqui: em dev ele fala com /collect pelo proxy do
# Vite. Em produção, aponte o site para o domínio do coletor com
# VITE_COLLECT_BASE no client, e liste esse domínio em EVENTS_CORS_ORIGINS.
